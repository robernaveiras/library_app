# ============================================
# Biblioteca App - Configuración local
# Copia este archivo a .env y rellena tus claves
# ============================================

# Servidor
APP_HOST=0.0.0.0
APP_PORT=8000
DATA_DIR=./data

# Proveedor de IA por defecto: "gemini" o "strata"
DEFAULT_AI_PROVIDER=gemini

# --- Proveedor 1: Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Proveedor 2: Strata (API compatible con OpenAI - Qwen3.8-Flash-Next Gyro-M) ---
STRATA_BASE_URL=http://localhost:8080/v1
STRATA_API_KEY=
STRATA_MODEL=Qwen3.8-Flash-Next-Gyro-M

# --- Opcional: Google Books API Key (funciona sin clave con cuota básica) ---
GOOGLE_BOOKS_API_KEY=
